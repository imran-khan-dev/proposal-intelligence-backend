# AI provider selection: "ollama", "openai", "kilo", "google", or "groq"
AI_PROVIDER=ollama

# Ollama configuration (used when AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:4b

# Kilo configuration (used when AI_PROVIDER=kilo)
KILO_BASE_URL=https://api.kilo.ai/api/gateway
KILO_API_KEY=
KILO_MODEL=kilo-auto/free

# OpenAI configuration (used when AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini configuration (used when AI_PROVIDER=google)
# Uses the Gemini Interactions API (genai.Client.interactions.create).
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.8-flash

# Groq configuration (used when AI_PROVIDER=groq)
# Uses the OpenAI-compatible chat completions endpoint.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b

# Embedding provider selection: "local" or "api" (independent of AI_PROVIDER)
EMBEDDING_PROVIDER=local

# Local embedding configuration (used when EMBEDDING_PROVIDER=local)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# API embedding configuration (used when EMBEDDING_PROVIDER=api)
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1

# Vector store configuration (independent of AI_PROVIDER and EMBEDDING_PROVIDER)
VECTOR_STORE_TYPE=postgresql
# VECTOR_STORE_PATH=./data/vector_store.jsonl

DATABASE_URL=postgresql://postgres:45.86.86.86@localhost:5432/rfp_ai
# AI provider selection: "ollama", "openai", "kilo", "google", or "groq"
#   - Set AI_PROVIDER to choose the default provider for all contexts.
#   - Set RFP_AI_PROVIDER to override the provider used for RFP analysis.
#   - Set AGENT_AI_PROVIDER to override the provider used for agent calls.
#   - If a task-specific variable is set but empty, it falls back to AI_PROVIDER.
#   - AI_TIMEOUT and AI_MAX_RETRIES are global fallback values used when a provider does not receive an explicit timeout or max_retries (e.g., when the provider's own default is desired).
#   - For Ollama and Kilo, if AI_TIMEOUT is not set, a hardcoded timeout of 120.0 is preserved for backward compatibility.
AI_PROVIDER=ollama

# Global timeout and retry settings (optional)
# AI_TIMEOUT: Request timeout in seconds (float). If not set, provider-specific defaults are used.
# AI_MAX_RETRIES: Maximum retry attempts (int). If not set, provider-specific defaults are used.
AI_TIMEOUT=
AI_MAX_RETRIES=

# Ollama configuration (used when AI_PROVIDER=ollama or RFP_AI_PROVIDER=ollama or AGENT_AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:4b

# Kilo configuration (used when AI_PROVIDER=kilo or RFP_AI_PROVIDER=kilo or AGENT_AI_PROVIDER=kilo)
KILO_BASE_URL=https://api.kilo.ai/api/gateway
KILO_API_KEY=
KILO_MODEL=kilo-auto/free

# OpenAI configuration (used when AI_PROVIDER=openai or RFP_AI_PROVIDER=openai or AGENT_AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini configuration (used when AI_PROVIDER=google or RFP_AI_PROVIDER=google or AGENT_AI_PROVIDER=google)
# Uses the Gemini Interactions API (genai.Client.interactions.create).
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.8-flash

# Groq configuration (used when AI_PROVIDER=groq or RFP_AI_PROVIDER=groq or AGENT_AI_PROVIDER=groq)
# Uses the OpenAI-compatible chat completions endpoint.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b

# Task-specific max tokens (optional)
# RFP_AI_MAX_TOKENS: Maximum output tokens for RFP analysis (int). If not set, no limit.
# AGENT_AI_MAX_TOKENS: Maximum output tokens for agent calls (int). If not set, no limit.
RFP_AI_MAX_TOKENS=
AGENT_AI_MAX_TOKENS=

# Embedding provider selection: "local" or "api" (independent of AI_PROVIDER)
EMBEDDING_PROVIDER=local

# Local embedding configuration (used when EMBEDDING_PROVIDER=local)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# API embedding configuration (used when EMBEDDING_PROVIDER=api)
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1

# Vector store configuration (independent of AI_PROVIDER and EMBEDDING_PROVIDER)
VECTOR_STORE_TYPE=postgresql
# VECTOR_STORE_PATH=./data/vector_store.jsonl

DATABASE_URL=postgresql://postgres:45.86.86.86@localhost:5432/rfp_ai
